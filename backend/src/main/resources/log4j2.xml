<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <ReactiveAppender name="REACTIVE"/>

        <!-- Консольный аппендер с выравниванием -->
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout>
                <!--
                  %d — дата+время, с Т и смещением +03:00
                  %-5level — уровень, выровненный по ширине
                  %pid — PID процесса
                  [%thread] — имя треда
                  %-36logger — имя логгера, выровненное в колонке 36 символов
                  : %msg%n — двоеточие, пробел, сообщение и перевод строки
                -->
                <Pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}  %-5level %pid --- [%thread] %-36logger : %msg%n</Pattern>
            </PatternLayout>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="REACTIVE"/>
        </Root>
    </Loggers>
</Configuration>
